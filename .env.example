PORT=3000

# Prestatario demo (también var.borrower_name en el outbound)
BORROWER_NAME=Ana

# --- Outbound WhatsApp (valores solo en .env / hosting, no en el repo) ---
# URL completa del endpoint de envío
OUTBOUND_API_URL=
# API key y nombre del header (ej. el que indique la documentación del proveedor)
OUTBOUND_API_KEY=
OUTBOUND_API_KEY_HEADER=
# IDs del mensaje outbound y del flujo
OUTBOUND_ID=
FLOW_ID=
# Destinatario demo (sin código de país / código de país)
OUTBOUND_PHONE_NUMBER=
OUTBOUND_COUNTRY_CODE=

# URL del flujo embebido en el iframe (canal web)
IFRAME_FLOW_URL=

# --- Pagos simulados (segunda integración; requiere auth) ---
PAYMENTS_API_KEY=
