PORT=3000

# Prestatario demo (también var.borrower_name en el outbound)
BORROWER_NAME=Ana

# --- Outbound WhatsApp (valores solo en .env / hosting, no en el repo) ---
# URL completa del endpoint de envío
OUTBOUND_API_URL=
# API key y nombre del header (ej. el que indique la documentación del proveedor)
OUTBOUND_API_KEY=
OUTBOUND_API_KEY_HEADER=
# IDs del mensaje outbound y del flujo de WA
OUTBOUND_ID=
FLOW_ID=

# Destinatario demo
OUTBOUND_PHONE_NUMBER=
OUTBOUND_COUNTRY_CODE=

# --- Truora Digital Identity (canal web / iframe) ---
# Endpoint para generar el Web Integration Token
WEB_URL=
# Base del Process Link (se le añade ?token=...)
IFRAME_FLOW_URL=
# Redirect tras validación (pago simulado en una iteración posterior)
WEB_REDIRECT_URL=

# Flow web + account_id fallback
FLOW_WEB_ID=
ACCOUNT_ID=

# --- Pagos simulados (requiere auth) ---
PAYMENTS_API_KEY=
